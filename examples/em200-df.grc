options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Radiogoniometria con el R&S EM200 (traza DFPan): compas, azimut, calidad y nivel en vivo.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: em200_df
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: EM200 - Radiogoniometro
    window_size: (1000,1000)
  states:
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: freq
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,0,1,3
    label: Frecuencia (Hz)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: 20e6
    step: 12.5e3
    stop: 8e9
    value: 145e6
    widget: counter_slider
  states:
    coordinate: [200, 12]
    rotation: 0
    state: enabled
- name: df_bw
  id: variable_qtgui_chooser
  parameters:
    comment: 'Ancho de banda DF: ajustarlo al ancho de la emision'
    gui_hint: 1,0,1,1
    label: BW DF
    label0: ''
    label1: ''
    label2: ''
    label3: ''
    label4: ''
    labels: '["1 kHz", "3.1 kHz", "6 kHz", "12 kHz", "15 kHz", "25 kHz", "50 kHz", "120 kHz", "300 kHz", "1 MHz"]'
    num_opts: '0'
    option0: '0'
    option1: '1'
    option2: '2'
    option3: '3'
    option4: '4'
    options: '[1e3, 3.1e3, 6e3, 12e3, 15e3, 25e3, 50e3, 120e3, 300e3, 1e6]'
    orient: QtCore.Qt.QVBoxLayout
    type: real
    value: 15e3
    widget: combo_box
  states:
    coordinate: [360, 12]
    rotation: 0
    state: enabled
- name: meas_time
  id: variable_qtgui_chooser
  parameters:
    comment: 'Promediado DF. El manual recomienda 0.5 s en movimiento'
    gui_hint: 1,1,1,1
    label: Tiempo de medida
    label0: ''
    label1: ''
    label2: ''
    label3: ''
    label4: ''
    labels: '["0.1 s", "0.2 s", "0.5 s", "1 s", "2 s", "5 s"]'
    num_opts: '0'
    option0: '0'
    option1: '1'
    option2: '2'
    option3: '3'
    option4: '4'
    options: '[0.1, 0.2, 0.5, 1.0, 2.0, 5.0]'
    orient: QtCore.Qt.QVBoxLayout
    type: real
    value: '0.5'
    widget: combo_box
  states:
    coordinate: [520, 12]
    rotation: 0
    state: enabled
- name: df_mode
  id: variable_qtgui_chooser
  parameters:
    comment: ''
    gui_hint: 1,2,1,1
    label: Modo DF
    label0: Continuo
    label1: Normal (squelch)
    label2: Gate
    label3: ''
    label4: ''
    labels: '[]'
    num_opts: '3'
    option0: '"CONT"'
    option1: '"NORM"'
    option2: '"GATE"'
    option3: '3'
    option4: '4'
    options: '[0, 1, 2]'
    orient: QtCore.Qt.QVBoxLayout
    type: string
    value: '"CONT"'
    widget: combo_box
  states:
    coordinate: [680, 12]
    rotation: 0
    state: enabled
- name: em200_df_source_0
  id: em200_df_source
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    df_bandwidth: df_bw
    df_mode: df_mode
    freq: freq
    hold_last: 'True'
    ip: 192.168.29.200
    maxoutbuf: '0'
    meas_time: meas_time
    minoutbuf: '0'
    port: '5555'
    restore: 'True'
    span: 1e6
    threshold: '10'
  states:
    coordinate: [16, 220]
    rotation: 0
    state: enabled
- name: qtgui_compass_0
  id: qtgui_compass
  parameters:
    alias: ''
    backgroundColor: default
    comment: ''
    fullNeedle: '1'
    gui_hint: 2,0,2,1
    min_size: '300'
    name: '"Azimut"'
    needleBodyColor: black
    needleTipColor: red
    position: '1'
    scaleColor: black
    setDebug: 'False'
    update_time: '0.10'
    usemsg: 'False'
  states:
    coordinate: [400, 160]
    rotation: 0
    state: enabled
- name: qtgui_number_sink_0
  id: qtgui_number_sink
  parameters:
    affinity: ''
    alias: ''
    autoscale: 'False'
    avg: '0'
    color1: ("blue", "red")
    color10: ("black", "black")
    color2: ("black", "green")
    color3: ("black", "yellow")
    color4: ("red", "green")
    color5: ("black", "black")
    color6: ("black", "black")
    color7: ("black", "black")
    color8: ("black", "black")
    color9: ("black", "black")
    comment: ''
    factor1: '1'
    factor10: '1'
    factor2: '1'
    factor3: '1'
    factor4: '1'
    factor5: '1'
    factor6: '1'
    factor7: '1'
    factor8: '1'
    factor9: '1'
    graph_type: qtgui.NUM_GRAPH_HORIZ
    gui_hint: 2,1,1,2
    label1: Azimut
    label10: ''
    label2: Calidad
    label3: Nivel
    label4: Valido
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    max: '360'
    min: '0'
    name: '"Medida DF"'
    nconnections: '4'
    type: float
    unit1: deg
    unit10: ''
    unit2: '%'
    unit3: dBuV
    unit4: ''
    unit5: ''
    unit6: ''
    unit7: ''
    unit8: ''
    unit9: ''
    update_time: '0.10'
  states:
    coordinate: [400, 260]
    rotation: 0
    state: enabled
- name: qtgui_time_sink_x_0
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    axislabels: 'True'
    color1: blue
    color10: dark blue
    color2: red
    color3: green
    color4: black
    color5: cyan
    color6: magenta
    color7: yellow
    color8: dark red
    color9: dark green
    comment: 'Historico de ~60 s (unas 10 medidas por segundo)'
    ctrlpanel: 'False'
    entags: 'False'
    grid: 'True'
    gui_hint: 3,1,1,2
    label1: Azimut
    label10: ''
    label2: Calidad
    label3: ''
    label4: ''
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    legend: 'True'
    marker1: '0'
    marker10: '-1'
    marker2: '-1'
    marker3: '-1'
    marker4: '-1'
    marker5: '-1'
    marker6: '-1'
    marker7: '-1'
    marker8: '-1'
    marker9: '-1'
    name: '"Historico azimut / calidad"'
    nconnections: '2'
    size: '600'
    srate: '10'
    stemplot: 'False'
    style1: '0'
    style10: '1'
    style2: '1'
    style3: '1'
    style4: '1'
    style5: '1'
    style6: '1'
    style7: '1'
    style8: '1'
    style9: '1'
    tr_chan: '0'
    tr_delay: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: float
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    ylabel: Azimut (deg) / Calidad (%)
    ymax: '360'
    ymin: '0'
    yunit: '""'
  states:
    coordinate: [400, 400]
    rotation: 0
    state: enabled
- name: blocks_message_debug_0
  id: blocks_message_debug
  parameters:
    affinity: ''
    alias: ''
    comment: 'Habilitalo para ver en consola cada medida completa (rumbo, GPS, timestamps...)'
    en_uvec: 'True'
  states:
    coordinate: [400, 540]
    rotation: 0
    state: disabled

connections:
- [em200_df_source_0, '0', qtgui_compass_0, '0']
- [em200_df_source_0, '0', qtgui_number_sink_0, '0']
- [em200_df_source_0, '1', qtgui_number_sink_0, '1']
- [em200_df_source_0, '2', qtgui_number_sink_0, '2']
- [em200_df_source_0, '3', qtgui_number_sink_0, '3']
- [em200_df_source_0, '0', qtgui_time_sink_x_0, '0']
- [em200_df_source_0, '1', qtgui_time_sink_x_0, '1']
- [em200_df_source_0, df, blocks_message_debug_0, print]

metadata:
  file_format: 1
  grc_version: 3.10.9.2
